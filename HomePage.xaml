<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZapretReborn.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZapretReborn"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
    </Page.Resources>

    <Grid Padding="7,25,0,0">
        <StackPanel Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel x:Name="HeaderPanel" Spacing="1" Margin="4,0,0,4" Opacity="0">

                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="HeaderTransform" Y="20"/>
                </StackPanel.RenderTransform>

                <StackPanel Spacing="1" Margin="4,0,0,4">
                    <TextBlock Text="Zapret Reborn" 
               FontSize="20" 
               FontWeight="Bold" 
               HighContrastAdjustment="None"
               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="DISCORD &amp; YOUTUBE" 
               FontFamily="Segoe UI Variable Display"
               FontSize="13" 
               FontWeight="Medium" 
               CharacterSpacing="120" 
               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                    <TextBlock Text="by ConDucTor" 
               FontFamily="Segoe UI Variable Text"
               FontSize="11" 
               FontWeight="Medium" 
               CharacterSpacing="50"
               Foreground="{ThemeResource SystemControlForegroundBaseLowBrush}"
               Margin="0,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="MainControlCard" 
                    Opacity="0"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                    BorderBrush="{ThemeResource SystemBaseLowColor}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Width="264">
                
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MainControlCardTransform" Y="15"/>
                </Border.RenderTransform>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="TopControlPanel" 
                          Grid.Row="0"
                          Canvas.ZIndex="2" 
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          Padding="15,10,15,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="-2">
                            <TextBlock Text="Статус службы" FontWeight="SemiBold" FontSize="16"  />
                            <TextBlock x:Name="StatusText" Text="Отключено" Foreground="Gray" FontSize="13"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="ConnectionSwitch" 
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      MinWidth="0"
                                      OnContent=""
                                      OffContent=""
                                      Toggled="ConnectionSwitch_Toggled"/>
                    </Grid>

                    <ScrollViewer x:Name="BottomScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Disabled" 
                                  HorizontalScrollBarVisibility="Disabled" 
                                  VerticalScrollMode="Disabled" 
                                  HorizontalScrollMode="Disabled"
                                  Canvas.ZIndex="1"
                                  Padding="15,0,15,15">
                        <StackPanel x:Name="ScriptSelectionContainer" Spacing="5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="ScriptSelectionTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <MenuFlyoutSeparator x:Name="SeparatorElement" Margin="0,0,0,8"/>

                            <TextBlock Text="Выберите режим/скрипт:" FontWeight="Medium" FontSize="14"/>
                            <ComboBox x:Name="ScriptComboBox" 
                                      HorizontalAlignment="Stretch" 
                                      PlaceholderText="Загрузка скриптов..."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="StatusPanel" 
                        Grid.Row="2"
                        Spacing="10" 
                        Visibility="Collapsed" 
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="StatusPanelTransform" Y="20"/>
                </StackPanel.RenderTransform>

                <!--<MenuFlyoutSeparator Margin="0,0,0,4"/>-->

                <TextBlock Text="Проверка доступности ресурсов" 
                           FontSize="12"
                           FontWeight="SemiBold" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                           Margin="2,0,0,0"/>

                <Grid Height="80" 
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                      BorderBrush="{ThemeResource SystemBaseLowColor}" 
                      BorderThickness="1" 
                      CornerRadius="10" 
                      Padding="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" 
                           Source="ms-appx:///Assets/YouTubeLogo.png" 
                           Height="44" 
                           Width="199"
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           />

                    <Grid Grid.Column="1" Canvas.ZIndex="0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                        <ProgressRing x:Name="YouTubeProgress" IsActive="False" Width="20" Height="20" />
                        <SymbolIcon x:Name="YouTubeStatusIcon" Symbol="Cancel" Foreground="Transparent" Height="40" Width="40"/>
                    </StackPanel>
                </Grid>

                <Grid Height="80"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                      BorderBrush="{ThemeResource SystemBaseLowColor}" 
                      BorderThickness="1" 
                      CornerRadius="10" 
                      Padding="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" 
                           Source="ms-appx:///Assets/discordLogo.png" 
                           Height="61" 
                           Width="210"
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"/>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0" Padding="0">
                        <ProgressRing x:Name="DiscordProgress"  IsActive="False" Width="20" Height="20" CornerRadius="10"/>
                        <SymbolIcon x:Name="DiscordStatusIcon" Symbol="Cancel" Foreground="Transparent"  Height="40" Width="40"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>